# ==============================================================================
# SECURE CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit your local '.env' file to Git!
# - Ensure '.env' is listed in .gitignore and .dockerignore
# - In production or CI, supply these via GitHub Secrets, Kubernetes Secrets,
#   AWS Secrets Manager, or HashiCorp Vault.
# ==============================================================================

# Server configuration
PORT=5000
FLASK_ENV=development

# Application Secret Key (Used for sessions & CSRF signing)
SECRET_KEY=replace-with-a-random-32-byte-hex-string

# AWS Integration (Obtain from AWS IAM or AWS STS AssumeRole)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1

# Database Connection (PostgreSQL / MySQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://app_user:replace_with_db_password@localhost:5432/app_db

# GitHub API Integration
GITHUB_TOKEN=your_github_personal_access_token_here

# Secret Leak Guard Custom Project Token (Example format: SLG_<32-char-token>)
SLG_PROJECT_API_TOKEN=your_slg_project_api_token_here

# Campus / College Auth Token (Example format: CAMPUS-YYYY-DEPT-XXXXXXXXXXXX)
CAMPUS_AUTH_TOKEN=CAMPUS-2024-ENGG-000000000000

# HashiCorp Vault Integration (Optional: Enable to load from Vault)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=payment-service
VAULT_MOUNT_POINT=secret
