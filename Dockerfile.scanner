# Multi-Stage Hardened Container for Universal Source Code Security Scanner
# syntax=docker/dockerfile:1.4

FROM python:3.12-slim-bookworm AS builder

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY scanner/ requirements.txt /build/
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt \
    && pip install --no-cache-dir --prefix=/install gitleaks-py trivy-py || true

# Production Minimal Stage
FROM python:3.12-slim-bookworm

LABEL maintainer="DevSecOps Team"
LABEL description="Universal Source Code Security Scanner"
LABEL version="2.0.0"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root system user
RUN groupadd -g 10001 scannergroup && \
    useradd -u 10001 -g scannergroup -m -s /bin/bash scanneruser

# Copy installed Python packages from builder
COPY --from=builder /install /usr/local

# Copy application codebase
COPY scanner/ /app/scanner/
COPY frontend/ /app/frontend/
COPY scripts/ /app/scripts/

# Create ephemeral sandbox workspace with correct ownership
RUN mkdir -p /tmp/scanner_workspaces && \
    chown -R scanneruser:scannergroup /app /tmp/scanner_workspaces

USER scanneruser

ENV PYTHONUNBUFFERED=1 \
    SCANNER_HOST=0.0.0.0 \
    SCANNER_PORT=5050 \
    MONGO_URI=mongodb://mongo:27017/secret_leak_guard \
    SCAN_WORKSPACE_DIR=/tmp/scanner_workspaces

EXPOSE 5050

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5050/api/v1/health || exit 1

ENTRYPOINT ["python", "scripts/run_scanner.py"]
